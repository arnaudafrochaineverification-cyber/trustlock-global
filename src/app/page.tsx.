
import { redirect } from "next/navigation";
import { createSupabaseServerClient } from "@/lib/supabase-server";

export const dynamic = "force-dynamic";

async function signOutAction() {
  "use server";

  const supabase = await createSupabaseServerClient();
  await supabase.auth.signOut();

  redirect("/login");
}

export default async function DashboardPage() {
  const supabase = await createSupabaseServerClient();

  const {
    data: { user },
    error
  } = await supabase.auth.getUser();

  if (error || !user) {
    redirect("/login");
  }

  if (!user.email_confirmed_at) {
    await supabase.auth.signOut();
    redirect("/login?error=email-not-confirmed");
  }

  const metadata = user.user_metadata ?? {};

  const companyName =
    metadata.companyName || "Company details pending";

  const country =
    metadata.country || "Not provided";

  const registrationNumber =
    metadata.registrationNumber || "Not provided";

  return (
    <main className="container section">
      <section className="status-panel">
        <p>TRUSTLOCK GLOBAL</p>

        <h1>Organization Dashboard</h1>

        <p>
          Welcome. Your account has successfully passed
          the email confirmation check.
        </p>

        <hr />

        <h2>Account Information</h2>

        <p>
          <strong>Company:</strong> {companyName}
        </p>

        <p>
          <strong>Email:</strong> {user.email}
        </p>

        <p>
          <strong>Country:</strong> {country}
        </p>

        <p>
          <strong>Registration Number:</strong>{" "}
          {registrationNumber}
        </p>

        <hr />

        <h2>Organization Verification</h2>

        <p>
          <strong>Account status:</strong> Awaiting
          organization verification.
        </p>

        <p>
          Your company details must be reviewed before
          organization approval features become available.
        </p>

        <hr />

        <h2>TRUSTLOCK Services</h2>

        <ul>
          <li>Organization verification — Coming soon</li>
          <li>Authorized officers — Coming soon</li>
          <li>Document authorization — Coming soon</li>
          <li>QR verification — Coming soon</li>
          <li>Audit history — Coming soon</li>
        </ul>

        <form action={signOutAction}>
          <button type="submit">
            Sign Out
          </button>
        </form>
      </section>
    </main>
  );
}
